  "behaviors": {
    "ev_adoption_diffusion": {
      "template": "diffusion",
      "params": {
        "node_type": "ev_market",
        "edge_type": "subsidy_flow",
        "field": "ev_adoption_rate",
        "rate": 0.003,
        "min_value": 0.0,
        "max_value": 1.0
      }
    },
    "emissions_decay_from_ev": {
      "template": "decay_growth",
      "params": {
        "node_type": "ev_market",
        "field": "emissions_mt",
        "rate": -0.004,
        "source_field": "ev_adoption_rate",
        "source_scale": -30.0,
        "min_value": 10.0,
        "max_value": 200.0
      }
    },
    "renewable_fraction_growth": {
      "template": "decay_growth",
      "params": {
        "node_type": "energy_grid",
        "field": "renewable_fraction",
        "rate": 0.002,
        "min_value": 0.0,
        "max_value": 1.0
      }
    },
    "subsidy_congestion": {
      "template": "capacity_constraint",
      "params": {
        "edge_type": "subsidy_flow",
        "alpha": 0.15,
        "beta": 4
      }
    },
    "adoption_cascade": {
      "template": "threshold_cascade",
      "params": {
        "node_type": "ev_market",
        "watch_field": "ev_adoption_rate",
        "threshold": 0.15,
        "direction": "above",
        "cascade_field": "charger_capacity",
        "cascade_value": 0.7,
        "edge_type": "vehicle_supply",
        "propagation": 0.6
      }
    },
    "vehicle_price_response": {
      "template": "price_response",
      "params": {
        "node_type": "manufacturer",
        "price_field": "price_index",
        "equilibrium": 0.7,
        "sensitivity": 0.02,
        "min_price": 0.6,
        "max_price": 1.5
      }
    }
  },
  "interventions": [
    {
      "id": "expand_ira_credits",
      "label": "Expand IRA Tax Credits",
      "description": "Increase federal EV tax credit from $7,500 to $10,000 and boost subsidy flows to all markets.",
      "type": "mutate_node",
      "target_id": "ira_policy_hub",
      "changes": {
        "state.subsidy_level": 10000,
        "state.adoption_boost": 1.5
      },
      "also_mutate": [
        {
          "target_id": "policy_to_texas",
          "changes": {
            "flow": 0.8
          }
        },
        {
          "target_id": "policy_to_midwest",
          "changes": {
            "flow": 0.75
          }
        },
        {
