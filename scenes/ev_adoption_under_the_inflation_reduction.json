            "flow": 0.7
          }
        }
      ]
    },
    {
      "id": "block_texas_subsidy",
      "label": "Texas Rejects EV Incentives",
      "description": "Texas state policy blocks IRA subsidy uptake, halting adoption flow to that market.",
      "type": "mutate_edge",
      "target_id": "policy_to_texas",
      "changes": {
        "state.blocked": true,
        "flow": 0.0
      }
    },
    {
      "id": "western_grid_clean",
      "label": "Western Grid Goes 80% Renewable",
      "description": "Accelerated renewable buildout drops carbon intensity of western charging significantly.",
      "type": "mutate_node",
      "target_id": "renewable_grid_west",
      "changes": {
        "state.renewable_fraction": 0.8,
        "state.carbon_intensity": 0.09
      }
    },
    {
      "id": "supply_chain_crunch",
      "label": "EV Supply Chain Shortage",
      "description": "Battery shortages reduce manufacturer output, cutting vehicle supply to all markets.",
      "type": "mutate_node",
      "target_id": "ev_manufacturer_hub",
      "changes": {
        "state.production_capacity": 0.3,
        "state.price_index": 1.4
      },
      "also_mutate": [
        {
          "target_id": "manufacturer_to_california",
