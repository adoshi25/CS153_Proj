  "behaviors": {
    "tanker_routing": {
      "template": "flow_conservation",
      "params": {
        "agent_type": "tanker",
        "edge_type": "shipping_lane",
        "speed_field": "speed_knots",
        "speed_unit": "knots",
        "reroute_on_block": true
      }
    },
    "lane_congestion": {
      "template": "capacity_constraint",
      "params": {
        "edge_type": "shipping_lane",
        "alpha": 0.15,
        "beta": 4
      }
    },
    "port_price_response": {
      "template": "price_response",
      "params": {
        "node_type": "destination_port",
        "price_field": "price_index",
        "equilibrium": 0.7,
        "sensitivity": 0.08,
        "min_price": 60,
        "max_price": 200
      }
    },
    "oil_stock_decay": {
      "template": "decay_growth",
      "params": {
        "node_type": "destination_port",
        "field": "oil_stock",
        "rate": -5,
        "min_value": 0,
        "max_value": 1000
      }
    },
    "threat_cascade": {
      "template": "threshold_cascade",
      "params": {
        "node_type": "chokepoint",
        "watch_field": "threat_level",
        "threshold": 0.8,
        "direction": "above",
        "cascade_field": "blocked",
        "cascade_value": 1,
        "edge_type": "shipping_lane",
        "propagation": 0.9
      }
    }
  },
  "interventions": [
    {
      "id": "reopen_hormuz",
      "label": "Ceasefire \u2013 Reopen Hormuz",
      "description": "A ceasefire is declared. The Strait of Hormuz reopens to commercial traffic.",
      "type": "mutate_edge",
      "target_id": "hormuz_to_oman",
      "changes": {
        "state.blocked": false,
        "cost": 24,
        "capacity": 10
      },
      "also_mutate": [
        {
          "target_id": "strait_of_hormuz",
          "changes": {
            "state.blocked": false,
            "state.threat_level": 0.1
          }
        }
      ]
    },
    {
      "id": "block_suez",
      "label": "Close Suez Canal",
      "description": "Regional conflict spreads. Egypt closes Suez Canal to tanker traffic.",
      "type": "mutate_edge",
      "target_id": "suez_to_rotterdam",
      "changes": {
        "state.blocked": true,
        "cost": 9999
      },
      "also_mutate": [
        {
          "target_id": "redsea_to_suez",
          "changes": {
            "state.blocked": true,
            "cost": 9999
          }
        },
        {
          "target_id": "suez_canal",
          "changes": {
            "state.threat_level": 0.9,
            "state.blocked": true
          }
        }
      ]
    },
    {
      "id": "cape_storm",
      "label": "Cape Storm Season",
      "description": "Severe storms at the Cape of Good Hope slow all tanker traffic around Africa.",
      "type": "mutate_edge",
      "target_id": "cape_to_rotterdam",
      "changes": {
        "cost": 720,
        "capacity": 6
      },
      "also_mutate": [
        {
          "target_id": "cape_to_houston",
          "changes": {
            "cost": 900,
            "capacity": 5
          }
        }
      ]
    },
    {
      "id": "strategic_reserve_release",
      "label": "Release Strategic Oil Reserves",
      "description": "IEA member nations release strategic petroleum reserves, boosting Rotterdam and Houston stocks.",
      "type": "mutate_node",
      "target_id": "rotterdam",
      "changes": {
        "state.oil_stock": 800,
        "state.price_index": 70
      },
      "also_mutate": [
        {
          "target_id": "houston",
          "changes": {
            "state.oil_stock": 750,
            "state.price_index": 72
          }
        }
      ]
    }
  ],
